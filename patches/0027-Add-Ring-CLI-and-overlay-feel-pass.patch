+  'sop_pump_p12_monitoring.md',
+  'maintenance_report.txt',
+  'maintenance_report_p12.txt',
+  'safety_thresholds.json',
+  'turbine_vibration_log.csv',
+  'pump_p12_vibration_log.csv',
